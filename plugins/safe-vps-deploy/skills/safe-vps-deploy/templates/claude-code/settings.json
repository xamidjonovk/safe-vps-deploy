{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/sdp_*)",
      "Bash(ssh root@*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.production)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh secret set*)",
      "Bash(gh repo deploy-key*)"
    ]
  }
}
